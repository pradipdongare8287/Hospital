              <option>All Status</option>
              <option>Pending</option>
              <option>Approved</option>
              <option>Completed</option>
              <option>Cancelled</option>
            </select>
            <input type="date" class="form-control" style="max-width:170px;" />
            <button type="button" class="btn btn-outline"><i class="fa-solid fa-file-arrow-down"></i> Export CSV</button>
            <a href="#appointment-form" class="btn btn-primary"><i class="fa-solid fa-plus"></i> New Appointment</a>
          </div>
        </div>

