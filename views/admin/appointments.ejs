        <div class="pagination">
          <button type="button" disabled><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" class="active">1</button>
          <button type="button">2</button>
          <button type="button">3</button>
          <button type="button"><i class="fa-solid fa-chevron-right"></i></button>
        </div>

        <div class="dashboard-panel" id="appointment-form" style="margin-top:1.75rem;">
          <div class="dashboard-panel-header"><h3><i class="fa-solid fa-calendar-plus"></i> Book New Appointment</h3></div>
          <div class="dashboard-panel-body">
            <form action="#" method="post">
              <div class="form-group">
                <label class="form-label" for="appt-patient">Existing Patient</label>
                <select id="appt-patient" name="patientId" class="form-control">
                  <option value="">— New patient —</option>
                  <option>John Anderson</option>
                  <option>Maria Garcia</option>
                  <option>David Lee</option>
                  <option>Sophia Turner</option>
                </select>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="appt-patient-name">Patient Name <span class="required">*</span></label>
                  <input type="text" id="appt-patient-name" name="patientName" class="form-control" placeholder="Full name" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="appt-patient-phone">Patient Phone</label>
                  <input type="tel" id="appt-patient-phone" name="patientPhone" class="form-control" placeholder="+1 555-0100" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="appt-patient-email">Patient Email</label>
                <input type="email" id="appt-patient-email" name="patientEmail" class="form-control" placeholder="patient@example.com" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="appt-department">Department <span class="required">*</span></label>
                  <select id="appt-department" name="departmentId" class="form-control" required>
                    <option value="">Select department</option>
                    <option>Cardiology</option>
                    <option>Orthopedics</option>
                    <option>Neurology</option>
                    <option>Pediatrics</option>
                    <option>Dental</option>
                    <option>Dermatology</option>
                    <option>ENT</option>
                    <option>General Medicine</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="appt-doctor">Doctor <span class="required">*</span></label>
                  <select id="appt-doctor" name="doctorId" class="form-control" required>
                    <option value="">Select doctor</option>
                    <option>Dr. Sarah Mitchell</option>
                    <option>Dr. James Carter</option>
                    <option>Dr. Priya Sharma</option>
                    <option>Dr. Michael Chen</option>
                    <option>Dr. Lisa Nguyen</option>
                    <option>Dr. Emily Davis</option>
                    <option>Dr. Ahmed Khan</option>
                    <option>Dr. Robert Williams</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="appt-date">Date <span class="required">*</span></label>
                  <input type="date" id="appt-date" name="date" class="form-control" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="appt-time">Time <span class="required">*</span></label>
                  <select id="appt-time" name="time" class="form-control" required>
                    <option value="">Select time</option>
                    <option>09:00 AM</option>
                    <option>10:00 AM</option>
                    <option>11:00 AM</option>
                    <option>01:00 PM</option>
                    <option>02:00 PM</option>
                    <option>03:00 PM</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="appt-status">Status</label>
                <select id="appt-status" name="status" class="form-control">
                  <option value="pending">Pending</option>
                  <option value="approved">Approved</option>
                  <option value="completed">Completed</option>
                  <option value="cancelled">Cancelled</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="appt-reason">Reason for Visit</label>
                <textarea id="appt-reason" name="reason" class="form-control" rows="3" placeholder="Reason for visit / symptoms…"></textarea>
              </div>
              <div class="form-actions">
                <button type="reset" class="btn btn-outline">Reset</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-calendar-plus"></i> Book Appointment</button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="../js/main.js"></script>
</body>
</html>
