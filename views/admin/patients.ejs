<%-include('header.ejs')%>

      <main class="dashboard-content">
        <div class="page-toolbar">
          <h2>All Patients <span class="badge badge-primary">1,248 of 1,248</span></h2>
          <div class="page-toolbar-actions">
            <select class="form-control" style="max-width:180px;">
              <option>All Status</option>
            </select>
            
          </div>
        </div>

        <div class="dashboard-panel" id="patient-form" style="margin-top:1.75rem;">
          <div class="dashboard-panel-header"><h3><i class="fa-solid fa-hospital-user"></i> Add Patient</h3></div>
          <div class="dashboard-panel-body">

            <form action="/admin/add_patient" method="post">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Full Name <span class="required"></span></label>
                  <input type="text"  name="patient_name" class="form-control" placeholder="Jane Doe" required />
                </div>
                <div class="form-group">
                  <label class="form-label" >Email <span class="required"></span></label>
                  <input type="email"  name="patient_email" class="form-control" required />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Phone</label>
                  <input type="tel" maxlength="10"  name="patient_phone" class="form-control" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                </div>
                <div class="form-group">
                  <label class="form-label" >Age</label>
                  <input type="number"  name="patient_age" class="form-control" min="0" max="120" />
                </div>
                <div class="form-group">
                  <label class="form-label" >Patient Add Date</label>
                  <input type="date"  name="patient_add_date" class="form-control" min="0" max="120" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Gender</label>
                  <select  name="patient_gender" class="form-control">
                    <option value="">Select</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" >Blood Group</label>
                  <select  name="patient_bloodGroup" class="form-control">
                    <option value="">Select</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" >Address</label>
                <input type="text"  name="patient_address" class="form-control" placeholder="Street, City, State" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Status</label>
                  <select  name="patient_status" class="form-control">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                  </select>
                </div>
              </div>
              <div class="form-actions">
                <button type="reset" class="btn btn-outline">Reset</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Patient</button>
              </div>
            </form>
          </div>
        </div>

        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th>Patient</th>
                <th>Contact</th>
                <th>Gender</th>
                <th>Blood Group</th>
                <th>Registered</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for(var i=0;i<patients.length;i++){ %>
              <tr>
                <td><div class="user-meta"><img class="avatar" src="/images/<%=patients[i].Patient_image%>" alt="<%=patients[i].Patient_name%>" /><div class="name"><%=patients[i].Patient_name%></div></div></td>
                <td><%=patients[i].Patient_email%><br /><span class="text-muted"><%=patients[i].Patient_phone%></span></td>
                <td><%=patients[i].Patient_gender%></td>
                <td><%=patients[i].Patient_bloodGroup%></td>
                <td><%=patients[i].Patient_add_date%></td>
                <td><span class="status-badge active"><%=patients[i].patient_status%></span></td>
                <td><div class="table-actions"><a href="#patient-form" class="btn btn-sm btn-outline" aria-label="Edit"><i class="fa-solid fa-pen"></i></a><button type="button" class="btn btn-sm btn-outline" style="color:var(--danger);" aria-label="Delete"><i class="fa-solid fa-trash"></i></button></div></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
       

        
      </main>
    </div>
  </div>

<%-include('footer.ejs')%>
