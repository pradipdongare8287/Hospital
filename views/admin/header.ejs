<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin Dashboard | MediCare Plus</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="dashboard-body">

  <div class="dashboard-layout role-admin">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
        <span class="sidebar-brand-text">Medi<span>Care</span> Plus</span>
      </div>
      <div class="sidebar-user">
        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="Admin avatar" />
        <div class="sidebar-user-info">
          <h5>System Admin</h5>
          <span>ADMIN</span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <span class="nav-section-label">Overview</span>
        <a href="/admin" class="nav-item active"><i class="fa-solid fa-gauge-high"></i><span class="nav-label">Dashboard</span></a>

        <span class="nav-section-label">Hospital Management</span>
        <a href="/admin/doctors" class="nav-item"><i class="fa-solid fa-user-doctor"></i><span class="nav-label">Doctors</span></a>
        <a href="/admin/patient" class="nav-item"><i class="fa-solid fa-hospital-user"></i><span class="nav-label">Patients</span></a>
        <a href="/admin/appointments" class="nav-item"><i class="fa-solid fa-calendar-check"></i><span class="nav-label">Appointments</span></a>
        <a href="/admin/departments" class="nav-item"><i class="fa-solid fa-sitemap"></i><span class="nav-label">Departments</span></a>
        <a href="/admin/treatments" class="nav-item"><i class="fa-solid fa-stethoscope"></i><span class="nav-label">Treatments</span></a>
        <a href="/admin/medicines" class="nav-item"><i class="fa-solid fa-pills"></i><span class="nav-label">Medicines</span></a>

        <span class="nav-section-label">Insights</span>
        <a href="/admin/reports" class="nav-item"><i class="fa-solid fa-chart-line"></i><span class="nav-label">Reports</span></a>
        <a href="/admin/settings" class="nav-item"><i class="fa-solid fa-gear"></i><span class="nav-label">Settings</span></a>
        <a href="/" class="nav-item"><i class="fa-solid fa-arrow-left"></i><span class="nav-label">Back to Site</span></a>
      </nav>
      <div class="sidebar-footer">
        <a href="/admin/login" class="nav-item logout-btn"><i class="fa-solid fa-right-from-bracket"></i><span class="nav-label">Logout</span></a>
      </div>
    </aside>
    <div class="sidebar-overlay"></div>

    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Dashboard</h1>
            <p>Hospital-wide overview &amp; analytics</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" placeholder="Quick search doctors, patients…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <a href="settings" class="topbar-btn" aria-label="Settings"><i class="fa-solid fa-gear"></i></a>
          <a href="/admin/login" class="topbar-btn" aria-label="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
          <div class="profile-dropdown">
            <div class="profile-trigger">
              <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="Admin avatar" />
              <span class="profile-name">System Admin</span>
            </div>
          </div>
        </div>
      </header>