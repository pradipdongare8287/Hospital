<%-include('header.ejs');%>

      <main class="dashboard-content">
        <div class="stat-cards" style="margin-bottom:1.75rem;">
          <div class="stat-card">
            <div class="stat-card-icon blue"><i class="fa-solid fa-sitemap"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total Departments</div>
              <div class="stat-card-value">9</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon green"><i class="fa-solid fa-bed"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Total Beds</div>
              <div class="stat-card-value">195</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon orange"><i class="fa-solid fa-user-doctor"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Assigned Doctors</div>
              <div class="stat-card-value">36</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-card-icon purple"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="stat-card-body">
              <div class="stat-card-label">Unstaffed</div>
              <div class="stat-card-value">1</div>
            </div>
          </div>
        </div>

        <div class="page-toolbar">
          <h2>All Departments <span class="badge badge-primary">9 of 9</span></h2>
        </div>

        <div class="dashboard-grid">
          <% for(var a=0;a<3;a++){ %>
          <div class="col-4">
            <div class="dashboard-panel">
              <div class="dashboard-panel-body" style="text-align:center;">
                <div class="stat-card-icon blue" style="margin:0 auto 0.85rem;"><i class="<%=departments[a].Department_icon%>"></i></div>
                <h4><%=departments[a].Department_name%></h4>
                <p class="text-muted" style="font-size:0.85rem;margin:0.35rem 0 0.85rem;"><%=departments[a].Department_discription%></p>
                <div class="table-actions" style="justify-content:center;"><span class="badge badge-primary"><%=departments[a].Doctors%></span><span class="badge badge-info"><%=departments[a].Beads%> Beds</span></div>
              </div>
            </div>
          </div>  
          <% } %>
        </div>


        <!-- ========================================DEPARTMENT ADDING FORM =============================================== -->


<div style="min-height:100vh;background:linear-gradient(135deg,#0f172a,#1e3a8a,#06b6d4);display:flex;justify-content:center;align-items:center;padding:50px;">

    <form action="/admin/add_department" method="post"
                              style="width:850px;
                              background:rgba(255,255,255,0.12);
                              backdrop-filter:blur(20px);
                              border-radius:30px;
                              padding:40px;
                              box-shadow:0px 20px 60px rgba(0,0,0,.35);
                              border:1px solid rgba(255,255,255,.2);">

                              <h1 style="text-align:center;
                              color:white;
                              font-size:34px;
                              margin-bottom:8px;">
                                  🏥 Add Department
                              </h1>

                              <p style="text-align:center;
                              color:#dbeafe;
                              margin-bottom:35px;">
                                  Create a new hospital department
                              </p>

        <div style="display:grid;
        grid-template-columns:1fr 1fr;
        gap:25px;">

            <!-- Logo -->

                  <div>
                      <label style="display:block;
                      color:white;
                      font-weight:bold;
                      margin-bottom:8px;">
                          Department Icon
                      </label>

                      <input type="text" name="department_icon"

                          style="width:100%;
                          padding:14px;
                          border:none;
                          border-radius:12px;
                          background:white;">
                  </div>

            <!-- Department Name -->

                  <div>
                      <label style="display:block;
                      color:white;
                      font-weight:bold;
                      margin-bottom:8px;">
                          Department Name
                      </label>

                      <input type="text"
                          name="department_name"
                          placeholder="Cardiology"

                          style="width:100%;
                          padding:14px;
                          border:none;
                          outline:none;
                          border-radius:12px;
                          font-size:16px;">
                  </div>

            <!-- Doctors -->

                  <div>
                      <label style="display:block;
                      color:white;
                      font-weight:bold;
                      margin-bottom:8px;">
                          Doctors
                      </label>

                      <input type="text"
                          maxlength="2"
                          oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                          name="doctors"
                          placeholder="ex. 1,2,3,4"

                          style="width:100%;
                          padding:14px;
                          border:none;
                          outline:none;
                          border-radius:12px;
                          font-size:16px;">
                  </div>

            <!-- Beds -->

                  <div>
                      <label style="display:block;
                      color:white;
                      font-weight:bold;
                      margin-bottom:8px;">
                          Beds
                      </label>

                      <input type="text"
                          maxlength="2"
                          name="beds"
                          pattern="[0-9]{2}"
                          oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                          placeholder="120"

                          style="width:100%;
                          padding:14px;
                          border:none;
                          outline:none;
                          border-radius:12px;
                          font-size:16px;">
                  </div>

        </div>

        <!-- Description -->

                  <div style="margin-top:25px;">

                      <label style="display:block;
                      color:white;
                      font-weight:bold;
                      margin-bottom:8px;">
                          Department Description
                      </label>

                      <textarea
                          name="department_description"
                          rows="6"
                          placeholder="Write department details..."

                          style="width:100%;
                          padding:16px;
                          border:none;
                          outline:none;
                          border-radius:15px;
                          resize:none;
                          font-size:16px;"></textarea>

                  </div>

        <!-- Button -->

                    <div style="text-align:center;
                    margin-top:35px;">

                        <button
                            style="padding:16px 60px;
                            border:none;
                            border-radius:50px;
                            background:linear-gradient(90deg,#22c55e,#16a34a);
                            color:white;
                            font-size:18px;
                            font-weight:bold;
                            cursor:pointer;
                            transition:.3s;
                            box-shadow:0px 10px 30px rgba(34,197,94,.5);">

                            ➕ Add Department

                        </button>

                    </div>

    </form>

</div>


         <!-- ============================================================================================================= -->

        <div class="table-wrapper" style="margin-top:1.5rem;">
          <table class="table">
            <thead>
              <tr>
                <th>Department</th>
                <th>Doctors</th>
                <th>Beds</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for (var i=0;i<departments.length;i++){ %>
              <tr>
                <td><i class="<%=departments.Department_icon%>" style="color:var(--primary);margin-right:0.5rem;"></i><%=departments[i].Department_name%></td>
                <td><%=departments[i].Doctors%></td>
                <td><%=departments[i].Beads%></td>
                <td>
                  <div class="table-actions">
                     <a href="/admin/Edit_department/<%=departments[i].Did%>" onclick="return confirm('Are you sure Edit <%=departments[i].Department_name%> Department')" class="btn btn-sm btn-outline" ><i class="fa-solid fa-pen"></i></a>
                     <a href="/admin/Delete_department/<%=departments[i].Did%>" onclick="return confirm('Are you sure delete <%=departments[i].Department_name%> department')"><button type="button" class="btn btn-sm btn-outline" style="color:var(--danger);" ><i class="fa-solid fa-trash"></i></button></a>
                  </div>
                </td>
                </tr>
                <% } %>
            </tbody>
          </table>
        </div>
        <div class="pagination">
          <button type="button" disabled><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" class="active">1</button>
          <button type="button"><i class="fa-solid fa-chevron-right"></i></button>
        </div>

      </main>
    </div>
  </div>

  <%-include('footer.ejs')%>