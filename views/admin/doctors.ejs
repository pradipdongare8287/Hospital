<%-include('header.ejs')%>
      <main class="dashboard-content">
        <div class="page-toolbar">
          <h2>All Doctors <span class="badge badge-primary">42 of 42</span></h2>
          <div class="page-toolbar-actions">
            <select class="form-control" style="max-width:180px;">
              <option>All Status</option>
              <option>Active</option>
              <option>Inactive</option>
            </select>
           
          </div>
        </div>

<!-- ==================================================DOCTOR ADDING FORM =================================================== -->

<div style="max-width: 850px;margin: 40px auto;padding: 35px;border-radius: 24px;background: linear-gradient(145deg,#ffffff,#f4f8ff);box-shadow: 0 20px 50px rgba(15,23,42,.12);font-family: Arial,sans-serif;">

    <!-- Heading -->
    <h2 style="margin:0;text-align:center;color:#172554;font-size:30px;letter-spacing:.5px;">
        <span style="display:inline-flex;width:58px;height:58px;align-items:center;justify-content:center;margin-right:10px;border-radius:18px;color:white;background:linear-gradient(135deg,#2563eb,#06b6d4);box-shadow:0 10px 25px rgba(37,99,235,.25);">
            <i class="fa-solid fa-user-doctor"></i>
        </span>
        Add New Doctor
    </h2>

    <p style="text-align:center;color:#64748b;margin:10px 0 32px;">
        Create a professional doctor profile
    </p>


    <form action="/admin/add_doctor" method="POST" enctype="multipart/form-data">


                  <!-- Doctor Name -->
                  <label style="display:block;margin-bottom:7px;color:#334155;font-weight:bold;">
                      <i class="fa-solid fa-user" style="color:#2563eb;"></i>
                      Doctor Name
                  </label>

                  <input type="text" name="doctor_name" placeholder="Enter doctor name" required style="width:100%;box-sizing:border-box;padding:15px 18px;margin-bottom:22px;border:2px solid #e2e8f0;border-radius:13px;outline:none;background:white;font-size:15px;transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#2563eb';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(37,99,235,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">


                  <!-- Speciality -->
                  <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-stethoscope" style="color:#06b6d4;"></i>
                      Speciality
                  </label>

                  <input type="text"
                        name="speciality"
                        placeholder="Ex. Cardiologist"
                        required
                        style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#06b6d4';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(6,182,212,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">


                  <!-- Department -->
                  <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-building" style="color:#7c3aed;"></i>
                      Doctor Department
                  </label>

                  <select name="department"
                          required
                          style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              cursor:pointer;
                              transition:.35s;
                          "
                          onmouseover="
                              this.style.borderColor='#7c3aed';
                              this.style.boxShadow='0 8px 22px rgba(124,58,237,.12)'
                          "
                          onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.boxShadow='none'
                          ">

                      <option value="">Select Department</option>
                      <option>Cardiology</option>
                      <% for(var a=0;a<department.length;a++){ %>
                      <option><%=department[a].Department_name%></option>
                      <% } %>
                     

                  </select>


                  <!-- Experience -->
                  <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-briefcase" style="color:#f59e0b;"></i>
                      Doctor Experience
                  </label>

                  <input type="number"
                        name="experience"
                        min="0"
                        placeholder="Ex. 10 Years"
                        required
                        style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#f59e0b';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(245,158,11,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">


                  <!-- Rating -->
                  <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-star" style="color:#f59e0b;"></i>
                      Doctor Rating
                  </label>

                  <select name="rating"
                          required
                          style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              cursor:pointer;
                              transition:.35s;
                          "
                          onmouseover="
                              this.style.borderColor='#f59e0b';
                              this.style.boxShadow='0 8px 22px rgba(245,158,11,.12)'
                          "
                          onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.boxShadow='none'
                          ">

                      <option value="">Select Rating</option>
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4.5">4</option>
                      <option value="5">5</option>

                  </select>


                  <!-- Treat Patients -->
                  <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-hospital-user" style="color:#10b981;"></i>
                      Treat Patients
                  </label>

                  <input type="number"
                        name="treat_patient"
                        min="0"
                        placeholder="Ex. 200"
                        required
                        style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#10b981';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">

                    <!-- Doctor Gender -->
                      <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-venus-mars" style="color:#d80687;"></i>
                      Doctor Gender
                  </label>

                  <select 
                        name="Doctor_gender"
                        min="0"
                        placeholder="Ex. 200"
                        required
                        style="
                              width:50%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#d80687';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">
                        
                      <option value="Male">Male</option>
                      <option value="Female">Female</option>
                      <option value="Other">Other</option>

                      </select>

                    <!-- Doctor Email  -->
                       <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-envelope" style="color:#77a0e0;"></i>
                      Doctor Email
                  </label>

                  <input type="email"
                        name="Doctore_email"
                        min="0"
                        placeholder="Ex. admin@...."
                        required
                        style="
                              width:50%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#10b981';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">
                    <!-- Doctor Password -->
                     <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-lock" style="color:#fbff1e;"></i>
                      Doctor password
                  </label>

                  <input type="password"
                        name="Doctore_password"
                        min="0"
                        placeholder="Ex.admin@123"
                        required
                        style="
                              width:50%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#fbff1e';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">
                    <!-- Doctor Mobile -->
                     <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-phone" style="color:#1eff29;"></i>
                      Doctor Mobile
                  </label>

                  <input type="tel"
                        name="Doctore_mobile"
                        min="0"
                        placeholder="Ex.1234567890"
                        maxlength="10"
                        required
                        style="
                              width:50%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#1eff29';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">
                    <!-- Doctore Fee -->
                      <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-indian-rupee-sign" style="color:#b7c9c3;"></i>
                      Doctor Fee
                  </label>

                  <input type="number"
                        name="Doctore_fee"
                        min="0"
                        placeholder="Ex. 200"
                        required
                        style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#10b981';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">

                    <!-- Doctor Image -->
                 
                   <label style="
                      display:block;
                      margin-bottom:7px;
                      color:#334155;
                      font-weight:bold;
                  ">
                      <i class="fa-solid fa-image" style="color:#3616ec;"></i>
                      Doctor Photo
                  </label>

                  <input type="file"
                        name="doctor_photo"
                        min="0"
                        required
                        style="
                              width:100%;
                              box-sizing:border-box;
                              padding:15px 18px;
                              margin-bottom:22px;
                              border:2px solid #e2e8f0;
                              border-radius:13px;
                              outline:none;
                              background:white;
                              font-size:15px;
                              transition:.35s;
                        "
                        onmouseover="
                              this.style.borderColor='#3616ec';
                              this.style.transform='translateX(4px)';
                              this.style.boxShadow='0 8px 22px rgba(16,185,129,.12)'
                        "
                        onmouseout="
                              this.style.borderColor='#e2e8f0';
                              this.style.transform='translateX(0)';
                              this.style.boxShadow='none'
                        ">



                  <!-- Buttons -->
                  <button type="reset"
                          style="
                              padding:14px 28px;
                              margin-right:10px;
                              border:2px solid #e2e8f0;
                              border-radius:12px;
                              background:white;
                              color:#475569;
                              font-weight:bold;
                              cursor:pointer;
                              transition:.3s;
                          "
                          onmouseover="
                              this.style.background='#f1f5f9';
                              this.style.transform='translateY(-4px)'
                          "
                          onmouseout="
                              this.style.background='white';
                              this.style.transform='translateY(0)'
                          ">

                      <i class="fa-solid fa-rotate-left"></i>
                      Reset

                  </button>


                  <button type="submit"
                          style="
                              padding:14px 32px;
                              border:none;
                              border-radius:12px;
                              background:linear-gradient(135deg,#2563eb,#06b6d4);
                              color:white;
                              font-weight:bold;
                              font-size:15px;
                              cursor:pointer;
                              box-shadow:0 8px 20px rgba(37,99,235,.25);
                              transition:.35s;
                          "
                          onmouseover="
                              this.style.transform='translateY(-5px) scale(1.04)';
                              this.style.boxShadow='0 15px 30px rgba(37,99,235,.35)'
                          "
                          onmouseout="
                              this.style.transform='translateY(0) scale(1)';
                              this.style.boxShadow='0 8px 20px rgba(37,99,235,.25)'
                          ">

                      <i class="fa-solid fa-user-plus"></i>
                      Add Doctor

                  </button>

    </form>
</div>


<!-- ======================================================================================================================== -->
        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th>Sr.no</th>
                <th>Doctor</th>
                <th>Specialty</th>
                <th>Department</th>
                <th>Experience</th>
                <th>Fee</th>
                <th>Rating</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for (a=0;a<doctors.length;a++){ %>
              <tr>
                <td><%=1+a%></td>
                <td><div class="user-meta"><img class="avatar" src="/images/<%=doctors[a].Doctor_image%>" alt="" /><div><div class="name"><%=doctors[a].Doctor_name%></div><div class="sub"><%=doctors[a].Doctor_email%></div></div></div></td>
                <td><%=doctors[a].Doctor_specility%></td>
                <td><%=doctors[a].Doctor_department%></td>
                <td><%=doctors[a].Doctor_expirence%> yrs</td>
                <td>₹<%=doctors[a].Doctor_Fee%></td>
                
                <td>
                  <% for(var i=0;i<doctors[a].Doctor_rating;i++){ %>
                  <span class="stars"><i class="fa-solid fa-star"></i>
                  </span>
                  <% } %>
                  <%=doctors[a].Doctor_rating%>
                </td>
                
                <td>
                  <div class="table-actions">
                    <a href="/admin/edit_doctor/<%=doctors[a].Doc_id%>" onclick="return confirm('Edit <%=doctors[a].Doctor_name%> Doctor')"><button type="button" class="btn btn-sm btn-outline" style="color:var(--success);"><i class="fa-solid fa-pen"></i></i></button></a>
                    <a href="/admin/delete_doctor/<%=doctors[a].Doc_id%>" onclick="return confirm('Are you Sure Delete <%=doctors[a].Doctor_name%> ')"><button type="button" class="btn btn-sm btn-outline" style="color:var(--danger);"><i class="fa-solid fa-trash"></i></button></a>
                  </div>
                </td>
              </tr>
             <% } %>
             <!-- <i class="fa-solid fa-pen"></i> -->
          <button type="button" disabled><i class="fa-solid fa-chevron-left"></i></button>
          <button type="button" class="active">1</button>
          <button type="button">2</button>
          <button type="button">3</button>
          <button type="button"><i class="fa-solid fa-chevron-right"></i></button>
        </div>

       
      </main>
    </div>
  </div>

<%-include('footer.ejs')%>
