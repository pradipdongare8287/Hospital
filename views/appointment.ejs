<%-include('header.ejs');%>
  <main id="main-content">
    <section class="page-banner">
      <div class="container">
        <h1>Book an Appointment</h1>
        <div class="breadcrumb">
          <a href="index.html">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Appointment</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="contact-grid">
          <!-- Sidebar info -->
          <div class="contact-info-cards" data-aos="fade-right">
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-regular fa-clock"></i></div>
              <div>
                <h4>Working Hours</h4>
                <p>Mon–Fri: 8:00 AM – 8:00 PM<br>Sat: 9:00 AM – 5:00 PM<br>Sun: Emergency Only</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
              <div>
                <h4>Need Help Booking?</h4>
                <p>+1 (800) 555-0147<br>Emergency: 108</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-file-medical"></i></div>
              <div>
                <h4>What to Bring</h4>
                <p>Photo ID, insurance card (if any), current medications, and prior medical reports.</p>
              </div>
            </div>
            <div class="contact-info-card">
              <div class="info-icon"><i class="fa-solid fa-circle-info"></i></div>
              <div>
                <h4>Good to Know</h4>
                <p>Appointments are confirmed by our care team within one business day by phone or email.</p>
              </div>
            </div>
          </div>

          <!-- Appointment form -->
          <div class="contact-form-card" data-aos="fade-left">
            <h3><i class="fa-solid fa-calendar-plus text-primary"></i> Appointment Details</h3>
            <p>Fill in your information below and our care coordinators will confirm your preferred slot.</p>

            <form action="/website_appointment" method="post" >
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="apt-name">Full Name <span class="required">*</span></label>
                  <input type="text"  name="appo_patient_name" class="form-control" placeholder="Your full name" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="apt-phone">Phone Number <span class="required">*</span></label>
                  <input type="tel"  name="appo_phone" class="form-control" placeholder="+1 (555) 000-0000" required />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="apt-email">Email Address</label>
                <input type="email"  name="appo_email" class="form-control" placeholder="you@example.com"  required/>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="apt-dept">Department <span class="required">*</span></label>
                  <select id="apt-dept" name="appo_department" class="form-control" readonly>
                    <option value="<%=doctor.Doctor_department%>"><%=doctor.Doctor_department%></option>
                    
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="apt-doctor">Doctor <span class="required">*</span></label>
                  <select id="apt-doctor" name="appo_doctor" class="form-control" readonly>
                    <option value="<%=doctor.Doc_id%>"><%=doctor.Doctor_name%></option>
                  </select>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" >Appointment Book Date <span class="required"></span></label>
                  <input type="date"  name="appo_date" class="form-control" required />
                </div>
                <div class="form-group">
                  <label class="form-label" for="apt-time">Appointment Book Time <span class="required">*</span></label>
                  <input type="time"  name="appo_time" class="form-control" required />
                  
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="apt-reason">Reason for Visit</label>
                <textarea style="resize:none;" name="appo_reason" class="form-control" rows="4" placeholder="Briefly describe your symptoms or reason for the visit..."></textarea>
              </div>

              
              <button type="submit" class="btn btn-primary btn-lg btn-block">
                <i class="fa-solid fa-paper-plane"></i> Request Appointment
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ========== FOOTER ========== -->
 <%-include('footer.ejs')%>