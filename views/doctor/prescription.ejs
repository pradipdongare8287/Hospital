<%-include('header.ejs');%>


    <!-- ===================== MAIN ===================== -->
    <div class="dashboard-main">

      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Prescriptions</h1>
            <p>Create, preview, and print patient prescriptions</p>
          </div>
        </div>
        <div class="topbar-right">
          <button type="button" class="topbar-btn theme-toggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
          <div class="topbar-btn-wrap dropdown">
            <button type="button" class="topbar-btn" data-dropdown aria-label="Notifications">
              <i class="fa-solid fa-bell"></i>
              <span class="notif-badge">3</span>
            </button>
            <div class="notif-dropdown">
              <div class="notif-dropdown-header">
                <h4>Notifications</h4>
                <a href="dashboard.html#notifications">Mark all read</a>
              </div>
              <div class="notification-list">
                <div class="notification-item unread">
                  <div class="notification-icon success"><i class="fa-solid fa-user-plus"></i></div>
                  <div class="notification-body">
                    <h5>New Patient Assigned</h5>
                    <p>Michael Carter has been assigned to your care.</p>
                    <span class="notif-time">1 hour ago</span>
                  </div>
                </div>
                <div class="notification-item unread">
                  <div class="notification-icon"><i class="fa-solid fa-calendar-check"></i></div>
                  <div class="notification-body">
                    <h5>Appointment Request</h5>
                    <p>Priya Anand requested an appointment for Jul 29.</p>
                    <span class="notif-time">3 hours ago</span>
                  </div>
                </div>
                <div class="notification-item">
                  <div class="notification-icon warning"><i class="fa-solid fa-flask"></i></div>
                  <div class="notification-body">
                    <h5>Lab Result Alert</h5>
                    <p>Abnormal result flagged for patient Daniel Osei.</p>
                    <span class="notif-time">Yesterday</span>
                  </div>
                </div>
              </div>
              <div class="notif-dropdown-footer">
                <a href="dashboard.html#notifications">View All Notifications</a>
              </div>
            </div>
          </div>
          <div class="profile-dropdown dropdown">
            <button type="button" class="profile-trigger" data-dropdown>
              <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=200&q=80" alt="Dr. Sarah Mitchell" />
              <span class="profile-name">Dr. Sarah Mitchell</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong>Dr. Sarah Mitchell</strong>
                <span>Cardiology</span>
              </div>
              <a href="profile.html"><i class="fa-solid fa-user"></i> My Profile</a>
              <a href="schedule.html"><i class="fa-solid fa-calendar-days"></i> My Schedule</a>
              <div class="divider"></div>
              <a href="/docotr/logout" class="danger"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content">

        <!-- Builder form -->
        <div class="dashboard-panel" style="margin-bottom:1.75rem;">
          <div class="dashboard-panel-header">
            <h3>New Prescription</h3>
          </div>
          <div class="dashboard-panel-body">
            <form action="#" method="post">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Patient <span class="required">*</span></label>
                  <select class="form-control" name="patientId" required>
                    <option value="">Select Patient</option>
                    <option selected>Michael Carter</option>
                    <option>Emma Johnson</option>
                    <option>Priya Anand</option>
                    <option>Daniel Osei</option>
                    <option>Grace Kim</option>
                    <option>John Smith</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label">Date</label>
                  <input type="date" class="form-control" name="date" value="2026-07-23" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Diagnosis</label>
                <input type="text" class="form-control" name="diagnosis" value="Stage 1 hypertension, well controlled" />
              </div>

              <label class="form-label">Medicines</label>
              <div class="table-wrapper" style="margin-bottom:1rem;">
                <table class="table">
                  <thead>
                    <tr>
                      <th style="width:36%;">Medicine</th>
                      <th>Dosage</th>
                      <th>Frequency</th>
                      <th>Duration</th>
                      <th style="width:48px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td><input type="text" class="form-control" name="medicine[]" value="Amlodipine" /></td>
                      <td><input type="text" class="form-control" name="dosage[]" value="5mg" /></td>
                      <td><input type="text" class="form-control" name="frequency[]" value="Once daily" /></td>
                      <td><input type="text" class="form-control" name="duration[]" value="30 days" /></td>
                      <td><button type="button" class="btn btn-sm btn-ghost" aria-label="Remove row"><i class="fa-solid fa-trash"></i></button></td>
                    </tr>
                    <tr>
                      <td><input type="text" class="form-control" name="medicine[]" value="Atorvastatin" /></td>
                      <td><input type="text" class="form-control" name="dosage[]" value="20mg" /></td>
                      <td><input type="text" class="form-control" name="frequency[]" value="Once nightly" /></td>
                      <td><input type="text" class="form-control" name="duration[]" value="30 days" /></td>
                      <td><button type="button" class="btn btn-sm btn-ghost" aria-label="Remove row"><i class="fa-solid fa-trash"></i></button></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <button type="button" class="btn btn-ghost btn-sm" style="margin-bottom:1.25rem;">
                <i class="fa-solid fa-plus"></i> Add Medicine
              </button>

              <div class="form-group">
                <label class="form-label">Advice / Instructions</label>
                <textarea class="form-control" name="advice" placeholder="e.g. Take medicines after meals. Drink plenty of fluids. Follow up if symptoms persist beyond 5 days.">Continue daily walks and low-sodium diet. Recheck blood pressure and lipid panel in 6 weeks.</textarea>
              </div>

              <div class="form-actions">
                <button type="reset" class="btn btn-outline">Clear</button>
                <button type="button" class="btn btn-secondary"><i class="fa-solid fa-eye"></i> Preview</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Prescription</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Printable preview -->
        <div style="margin-bottom:1.75rem;">
          <div class="page-toolbar" style="margin-bottom:1rem;">
            <h2>Prescription Preview</h2>
            <div class="page-toolbar-actions">
              <button type="button" class="btn btn-primary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
            </div>
          </div>

          <div class="prescription-area prescription-print">
            <div class="prescription-header">
              <div class="rx-brand">
                <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
                <div>
                  <h2>MediCare Plus</h2>
                  <p>1250 Healing Way, Suite 100, Health City, HC 90210</p>
                </div>
              </div>
              <div class="rx-meta">
                <strong>Dr. Sarah Mitchell</strong>
                <span>Cardiology</span><br />
                <span>Rx No: RX2041</span><br />
                <span>Date: Jul 23, 2026</span>
              </div>
            </div>

            <div class="prescription-patient">
              <div class="rx-field">
                <label>Patient Name</label>
                <span>Michael Carter</span>
              </div>
              <div class="rx-field">
                <label>Age / Gender</label>
                <span>42 / Male</span>
              </div>
              <div class="rx-field">
                <label>Patient ID</label>
                <span>PT-1042</span>
              </div>
            </div>

            <div class="rx-field" style="margin-bottom:1.5rem;">
              <label>Diagnosis</label>
              <span>Stage 1 hypertension, well controlled</span>
            </div>

            <div class="prescription-rx">
              <div class="rx-symbol">℞</div>
              <table class="prescription-meds">
                <thead>
                  <tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr>
                </thead>
                <tbody>
                  <tr><td>Amlodipine</td><td>5mg</td><td>Once daily</td><td>30 days</td></tr>
                  <tr><td>Atorvastatin</td><td>20mg</td><td>Once nightly</td><td>30 days</td></tr>
                </tbody>
              </table>
            </div>

            <div class="prescription-notes">
              <h5><i class="fa-solid fa-circle-info"></i> Advice</h5>
              <p>Continue daily walks and low-sodium diet. Recheck blood pressure and lipid panel in 6 weeks.</p>
            </div>

            <div class="prescription-footer">
              <div>
                <p class="text-muted" style="font-size:0.8rem;margin:0;">This is a computer-generated prescription — MediCare Plus.</p>
              </div>
              <div class="rx-signature">
                <div class="sig-line"></div>
                <span>Dr. Sarah Mitchell</span>
              </div>
            </div>
          </div>
        </div>

        <!-- History -->
        <div class="dashboard-panel">
          <div class="dashboard-panel-header">
            <h3>Prescription History</h3>
          </div>
          <div class="dashboard-panel-body no-pad">
            <div class="table-wrapper">
              <table class="table">
                <thead>
                  <tr><th>Rx No.</th><th>Patient</th><th>Date</th><th>Diagnosis</th><th>Medicines</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>RX2041</code></td>
                    <td>Michael Carter</td>
                    <td>Jul 23, 2026</td>
                    <td>Stage 1 hypertension</td>
                    <td>2 meds</td>
                    <td class="table-actions"><button type="button" class="btn btn-sm btn-outline"><i class="fa-solid fa-eye"></i></button></td>
                  </tr>
                  <tr>
                    <td><code>RX2037</code></td>
                    <td>Daniel Osei</td>
                    <td>Jul 18, 2026</td>
                    <td>Abnormal lipid panel</td>
                    <td>1 med</td>
                    <td class="table-actions"><button type="button" class="btn btn-sm btn-outline"><i class="fa-solid fa-eye"></i></button></td>
                  </tr>
                  <tr>
                    <td><code>RX2019</code></td>
                    <td>Emma Johnson</td>
                    <td>Jul 10, 2026</td>
                    <td>Routine cardiac review</td>
                    <td>1 med</td>
                    <td class="table-actions"><button type="button" class="btn btn-sm btn-outline"><i class="fa-solid fa-eye"></i></button></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
<%-include('footer.ejs');%>
>
