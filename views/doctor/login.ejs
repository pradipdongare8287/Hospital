<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Log in to your MediCare Plus patient account to manage appointments and health records." />
  <meta name="keywords" content="patient login, hospital login" />
  <meta name="author" content="MediCare Plus" />
  <title>Login | MediCare Plus</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="css/main.css" />
</head>
<body data-page="login">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <div class="page-loader" id="page-loader">
    <div class="loader-pulse"></div>
    <span class="loader-text">MediCare Plus</span>
  </div>

  <!-- ========== TOP BAR ========== -->


  <!-- ========== HEADER ========== -->
  

  <div class="mobile-overlay" id="mobile-overlay"></div>
  <aside class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav-header">
      <span class="logo-text">Medi<span>Care</span> Plus</span>
      <button type="button" id="mobile-nav-close" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <a class="nav-link" href="index.html">Home</a>
    <a class="nav-link" href="about.html">About</a>
    <a class="nav-link" href="departments.html">Departments</a>
    <a class="nav-link" href="doctors.html">Doctors</a>
    <a class="nav-link" href="services.html">Services</a>
    <a class="nav-link" href="blog.html">Blog</a>
    <a class="nav-link" href="gallery.html">Gallery</a>
    <a class="nav-link" href="contact.html">Contact</a>
    <a class="nav-link" href="appointment.html">Book Appointment</a>
    <a class="nav-link active" href="login.html">Login / Register</a>
  </aside>

  <main id="main-content" class="auth-page">
    <div class="auth-visual">
      <div class="auth-visual-content">
        <a href="index.html" class="logo">
          <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
          <span class="logo-text">Medi<span>Care</span> Plus</span>
        </a>
        <h2>Welcome Back to Better Health</h2>
        <p>Access your appointments, prescriptions, and health records anytime, anywhere.</p>
        <ul class="auth-visual-features">
          <li><i class="fa-solid fa-check"></i> Book &amp; manage appointments in seconds</li>
          <li><i class="fa-solid fa-check"></i> View prescriptions &amp; visit history</li>
          <li><i class="fa-solid fa-check"></i> Secure, private patient dashboard</li>
        </ul>
      </div>
    </div>

    <div class="auth-form-side">
      <div class="auth-card">
        <div class="auth-logo-mobile">
          <a href="index.html" class="logo">
            <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
            <span class="logo-text">Medi<span>Care</span> Plus</span>
          </a>
        </div>

        <div class="auth-header">
          <h1>Sign In</h1>
          <p>Enter your credentials to access your account.</p>
        </div>

        <div class="alert alert-info">
          <i class="fa-solid fa-flask"></i>
          <div>
            <strong>Demo Note:</strong> This is a static preview page. Login is not yet connected to a backend — form submission will be wired up when patient accounts go live.
          </div>
        </div>

        <form action="#" method="post" novalidate>
          <div class="form-group">
            <label class="form-label" for="login-email">Email Address <span class="required">*</span></label>
            <div class="input-icon">
              <i class="fa-regular fa-envelope"></i>
              <input type="email" id="login-email" name="email" class="form-control" placeholder="you@example.com" required />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" for="login-password">Password <span class="required">*</span></label>
            <div class="input-icon right">
              <input type="password" id="login-password" name="password" class="form-control" placeholder="Enter your password" required />
              <i class="fa-regular fa-eye" data-toggle-password="login-password"></i>
            </div>
          </div>

          <div class="auth-remember">
            <label class="form-check">
              <input type="checkbox" name="remember" />
              <span>Remember me</span>
            </label>
            <a href="forgot-password.html">Forgot password?</a>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block">
            <i class="fa-solid fa-right-to-bracket"></i> Sign In
          </button>
        </form>

        <div class="auth-divider"><span>or</span></div>

        <div class="auth-social">
          <button type="button" class="btn btn-outline" disabled><i class="fa-brands fa-google"></i> Google</button>
          <button type="button" class="btn btn-outline" disabled><i class="fa-brands fa-facebook-f"></i> Facebook</button>
        </div>

        <p class="auth-footer">
          Don't have an account? <a href="register.html">Create one now</a>
        </p>
      </div>
    </div>
  </main>

  <!-- ========== FOOTER ========== -->
 

  <!-- Floating buttons -->
  <div class="float-btns">
    <a href="tel:108" class="float-btn emergency-float" title="Emergency"><i class="fa-solid fa-truck-medical"></i></a>
    <a href="https://wa.me/18005550147" target="_blank" rel="noopener" class="float-btn whatsapp" title="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
    <a href="appointment.html" class="float-btn appointment"><i class="fa-solid fa-calendar-check"></i> <span>Book</span></a>
    <a href="#top" class="float-btn scroll-top" title="Scroll to top"><i class="fa-solid fa-arrow-up"></i></a>
  </div>

  <script src="js/main.js"></script>
</body>
</html>
