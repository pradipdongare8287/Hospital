<%-include('header.ejs');%>

  <main id="main-content">
    <section class="page-banner">
      <div class="container">
        <h1>Our Departments</h1>
        <div class="breadcrumb">
          <a href="index.html">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Departments</span>
        </div>
      </div>
    </section>

    <!-- Department Grid -->
     <section class="section">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Centers of Excellence</span>
          <h2>Eight Specialized Care Units</h2>
          <p>Every department is staffed by board-certified specialists and equipped with modern diagnostic and treatment technology, all under one roof.</p>
        </div>
        <div class="dept-grid">
          <% for(var i=0;i<department.length;i++){ %>
          <article class="dept-card card-interactive" >
            <div class="dept-card-icon"><i class="<%=department[i].Department_icon%>"></i></div>
            <h3><%=department[i].Department_name%></h3>
            <p><%=department[i].Department_discription%></p>
            <div class="dept-card-meta"><span><i class="fa-solid fa-user-doctor"></i><%=department[i].Doctors%>  Doctors</span><span><i class="fa-solid fa-bed"></i><%=department[i].Beads%>  Beds</span></div>
            <a href="/doctors" class="btn btn-ghost btn-sm">View Doctors</a>
          </article>
          <% } %>
          
        </div>
      </div>
    </section>

    <!-- Department Detail Rows -->
    <section class="section bg-alt">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Learn More</span>
          <h2>Department Details</h2>
          <p>Capacity, specialist coverage, and what each unit treats.</p>
        </div>
        <div class="service-list">
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1628348068343-c6a848dcebbc?auto=format&fit=crop&w=400&q=80" alt="Cardiology suite" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-heart-pulse text-primary"></i> Cardiology</h4>
              <p>4 cardiologists, 24 beds, and a dedicated cath lab covering angioplasty, pacemaker implantation, and cardiac rehabilitation.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find a Cardiologist</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1559757175-5700dde9bc39?auto=format&fit=crop&w=400&q=80" alt="Neurology imaging" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-brain text-primary"></i> Neurology</h4>
              <p>3 neurologists and 18 beds treating stroke, epilepsy, migraine, and neurodegenerative disorders with EEG and MRI on site.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find a Neurologist</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=400&q=80" alt="Orthopedic care" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-bone text-primary"></i> Orthopedics</h4>
              <p>3 orthopedic surgeons, 20 beds, and an arthroscopy suite for joint replacement, sports injuries, and spine care.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find an Orthopedist</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&w=400&q=80" alt="Pediatric wing" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-baby text-primary"></i> Pediatrics</h4>
              <p>3 pediatricians and 16 beds in a child-friendly ward covering wellness visits, vaccines, and pediatric cardiology.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find a Pediatrician</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?auto=format&fit=crop&w=400&q=80" alt="Dental clinic" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-tooth text-primary"></i> Dental</h4>
              <p>2 dentists and 8 treatment chairs offering cleanings, cosmetic veneers, implants, and oral surgery.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find a Dentist</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=400&q=80" alt="Ophthalmology exam" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-eye text-primary"></i> Ophthalmology</h4>
              <p>2 ophthalmologists and 10 beds for cataract surgery, glaucoma management, and comprehensive eye exams.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find an Eye Specialist</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1581595220892-b24562acb1e4?auto=format&fit=crop&w=400&q=80" alt="Gynecology maternity ward" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-person-pregnant text-primary"></i> Gynecology</h4>
              <p>2 OB-GYNs and 14 beds supporting prenatal care, fertility consultations, and minimally invasive surgery.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find an OB-GYN</a>
          </div>
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=400&q=80" alt="Dermatology clinic" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-hand-holding-medical text-primary"></i> Dermatology</h4>
              <p>2 dermatologists and 6 private rooms treating acne, eczema, skin cancer screening, and laser therapy.</p>
            </div>
            <a href="doctors.html" class="btn btn-outline btn-sm">Find a Dermatologist</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container">
        <div class="cta-banner" data-aos="fade-up">
          <div class="container">
            <h2>Not Sure Which Department You Need?</h2>
            <p>Our care coordinators can help match you with the right specialist in minutes.</p>
            <div class="btn-group">
              <a href="doctors.html" class="btn btn-white btn-lg"><i class="fa-solid fa-user-doctor"></i> Browse All Doctors</a>
              <a href="contact.html" class="btn btn-outline-white btn-lg"><i class="fa-solid fa-phone"></i> Talk to Us</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ========== FOOTER ========== -->
 <%-include('footer.ejs'); %>