  <main id="main-content" class="auth-page centered">
    <div class="auth-card">
      <div class="d-flex justify-center mb-4">
        <a href="index.html" class="logo">
          <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
          <span class="logo-text">Medi<span>Care</span> Plus</span>
        </a>
      </div>

      <div class="auth-header">
        <h1>Forgot Password?</h1>
        <p>Enter your account email and our support team will send you password reset instructions.</p>
      </div>

      <div class="alert alert-info">
        <i class="fa-solid fa-flask"></i>
        <span>Demo Note: This is a static preview page. Password reset emails are not yet sent — this form will be connected to a backend service.</span>
      </div>

      <form action="#" method="post" novalidate>
        <div class="form-group">
          <label class="form-label" for="forgot-email">Email Address <span class="required">*</span></label>
          <div class="input-icon">
            <i class="fa-regular fa-envelope"></i>
            <input type="email" id="forgot-email" name="email" class="form-control" placeholder="you@example.com" required />
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg btn-block">
          <i class="fa-solid fa-key"></i> Send Reset Instructions
        </button>
      </form>

      <div class="auth-divider"><span>then set a new password</span></div>

      <form action="#" method="post" novalidate>
        <div class="form-group">
          <label class="form-label" for="reset-email">Email Address <span class="required">*</span></label>
          <input type="email" id="reset-email" name="email" class="form-control" placeholder="you@example.com" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="reset-token">Reset Code <span class="required">*</span></label>
            <input type="text" id="reset-token" name="token" class="form-control" placeholder="e.g. A1B2C3D4" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="reset-password">New Password <span class="required">*</span></label>
            <input type="password" id="reset-password" name="password" class="form-control" placeholder="Min. 6 characters" required minlength="6" />
          </div>
        </div>
        <button type="submit" class="btn btn-secondary btn-lg btn-block">
          <i class="fa-solid fa-lock-open"></i> Reset Password
        </button>
      </form>

      <p class="auth-footer">
        Remembered your password? <a href="login.html">Back to Sign In</a>
      </p>
    </div>
  </main>

