<%-include('header.ejs');%>

    <main class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Prescriptions</h1>
            <p>Your medication history, ready to view or print.</p>
          </div>
        </div>

        <form class="topbar-search" action="#" method="get" role="search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" name="q" placeholder="Search records, doctors, invoices…" aria-label="Search" />
        </form>

        <div class="topbar-right">
          <button type="button" class="topbar-btn theme-toggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>

          <div class="topbar-btn-wrap dropdown">
            <button type="button" class="topbar-btn" data-dropdown aria-label="Notifications">
              <i class="fa-solid fa-bell"></i>
              <span class="badge-dot">2</span>
            </button>
            <div class="notif-dropdown">
              <div class="notif-dropdown-header">
                <h4>Notifications</h4>
                <a href="notifications.html">Mark all read</a>
              </div>
              <div class="notification-list">
                <div class="notification-item unread">
                  <div class="notification-icon success"><i class="fa-solid fa-calendar-check"></i></div>
                  <div class="notification-body">
                    <h5>Appointment Confirmed</h5>
                    <p>Your visit with Dr. Sarah Mitchell on Jul 28 at 10:30 AM is confirmed.</p>
                    <span class="notif-time">2 hours ago</span>
                  </div>
                </div>
                <div class="notification-item unread">
                  <div class="notification-icon"><i class="fa-solid fa-flask"></i></div>
                  <div class="notification-body">
                    <h5>Lab Report Ready</h5>
                    <p>Your Complete Blood Count report is ready to download.</p>
                    <span class="notif-time">Yesterday</span>
                  </div>
                </div>
                <div class="notification-item">
                  <div class="notification-icon warning"><i class="fa-solid fa-credit-card"></i></div>
                  <div class="notification-body">
                    <h5>Payment Due</h5>
                    <p>Invoice INV-2041 of $85.00 is due on Aug 2.</p>
                    <span class="notif-time">2 days ago</span>
                  </div>
                </div>
              </div>
              <div class="notif-dropdown-footer">
                <a href="notifications.html">View All Notifications</a>
              </div>
            </div>
          </div>

          <div class="profile-dropdown dropdown">
            <button type="button" class="profile-trigger" data-dropdown>
              <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=200&q=80" alt="Emma Johnson" />
              <span class="profile-name">Emma Johnson</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong>Emma Johnson</strong>
                <span>emma.johnson@example.com</span>
              </div>
              <a href="profile.html"><i class="fa-solid fa-user"></i> My Profile</a>
              <a href="appointments.html"><i class="fa-solid fa-calendar-check"></i> My Appointments</a>
              <a href="notifications.html"><i class="fa-solid fa-bell"></i> Notifications</a>
              <div class="divider"></div>
              <a href="/petient/logout" class="danger"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content">

        <div class="page-toolbar">
          <h2>Prescriptions</h2>
          <div class="page-toolbar-actions">
            <span class="badge badge-primary">3 prescriptions</span>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:1.25rem; margin-bottom:1.75rem;">
          <div class="card">
            <div class="card-body">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.75rem;margin-bottom:1rem;">
                <div><h4 style="margin-bottom:0.25rem;">RX2041</h4>
                <span class="text-muted" style="font-size:0.85rem;">Jul 18, 2026</span></div>
                <span class="badge badge-primary"><i class="fa-solid fa-prescription"></i> 2 meds</span>
              </div>
              <p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:1rem;line-height:1.6;"><strong>Diagnosis:</strong> Stage 1 hypertension</p>
              <div class="user-meta" style="margin-bottom:1.35rem;">
                <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=200&q=80" class="avatar avatar-sm" alt="Dr. Sarah Mitchell" />
                <div><div class="name">Dr. Sarah Mitchell</div><div class="sub">Cardiology</div></div>
              </div>
              <a href="#rx-detail" class="btn btn-primary btn-block btn-sm"><i class="fa-solid fa-eye"></i> View &amp; Print</a>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.75rem;margin-bottom:1rem;">
                <div><h4 style="margin-bottom:0.25rem;">RX1987</h4>
                <span class="text-muted" style="font-size:0.85rem;">Jun 14, 2026</span></div>
                <span class="badge badge-primary"><i class="fa-solid fa-prescription"></i> 1 med</span>
              </div>
              <p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:1rem;line-height:1.6;"><strong>Diagnosis:</strong> Recurrent migraine with aura</p>
              <div class="user-meta" style="margin-bottom:1.35rem;">
                <img src="https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=200&q=80" class="avatar avatar-sm" alt="Dr. Priya Sharma" />
                <div><div class="name">Dr. Priya Sharma</div><div class="sub">Neurology</div></div>
              </div>
              <button type="button" class="btn btn-outline btn-block btn-sm"><i class="fa-solid fa-eye"></i> View &amp; Print</button>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.75rem;margin-bottom:1rem;">
                <div><h4 style="margin-bottom:0.25rem;">RX1802</h4>
                <span class="text-muted" style="font-size:0.85rem;">Feb 22, 2026</span></div>
                <span class="badge badge-primary"><i class="fa-solid fa-prescription"></i> 1 med</span>
              </div>
              <p style="font-size:0.9rem;color:var(--text-secondary);margin-bottom:1rem;line-height:1.6;"><strong>Diagnosis:</strong> Mild dental caries, upper molar</p>
              <div class="user-meta" style="margin-bottom:1.35rem;">
                <img src="https://images.unsplash.com/photo-1527613426441-4da17471b66d?auto=format&fit=crop&w=200&q=80" class="avatar avatar-sm" alt="Dr. Lisa Nguyen" />
                <div><div class="name">Dr. Lisa Nguyen</div><div class="sub">Dental</div></div>
              </div>
              <button type="button" class="btn btn-outline btn-block btn-sm"><i class="fa-solid fa-eye"></i> View &amp; Print</button>
            </div>
          </div>
        </div>

        <div class="prescription-area" id="rx-detail">
          <div class="prescription-header">
            <div class="rx-brand">
              <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
              <div><h2>MediCare Plus</h2><p>1250 Healing Way, Suite 100, Health City, HC 90210</p></div>
            </div>
            <div class="rx-meta"><strong>RX2041</strong><span>Date: Jul 18, 2026</span></div>
          </div>
          <div class="prescription-patient">
            <div class="rx-field"><label>Patient Name</label><span>Emma Johnson</span></div>
            <div class="rx-field"><label>Doctor</label><span>Dr. Sarah Mitchell</span></div>
            <div class="rx-field"><label>Department</label><span>Cardiology</span></div>
          </div>
          <div class="prescription-rx">
            <div class="rx-symbol">℞</div>
            <table class="prescription-meds">
              <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr></thead>
              <tbody>
                <tr><td>Amlodipine</td><td>5mg</td><td>Once daily</td><td>30 days</td></tr>
                <tr><td>Atorvastatin</td><td>20mg</td><td>Once nightly</td><td>30 days</td></tr>
              </tbody>
            </table>
          </div>
          <div class="prescription-notes">
            <h5><i class="fa-solid fa-note-sticky"></i> Doctor's Notes</h5>
            <p>Continue daily walks and low-sodium diet. Recheck blood pressure and lipid panel in 6 weeks.</p>
          </div>
          <div class="prescription-footer">
            <div><strong style="display:block;margin-bottom:0.35rem;color:var(--heading);">Diagnosis</strong>
            <p style="max-width:340px;font-size:0.9rem;color:var(--text-secondary);margin:0;">Stage 1 hypertension, well controlled</p></div>
            <div class="rx-signature"><div class="sig-line"></div><span>Dr. Sarah Mitchell</span></div>
          </div>
          <div class="prescription-actions">
            <button type="button" class="btn btn-outline"><i class="fa-solid fa-print"></i> Print</button>
            <button type="button" class="btn btn-primary"><i class="fa-solid fa-download"></i> Download PDF</button>
          </div>
        </div>

      </div>
    </main>
  </div>

<%-include('footer.ejs');%>
