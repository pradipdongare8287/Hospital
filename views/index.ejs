    <!-- FAQ -->
    <section class="section bg-alt" id="faq">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Help Center</span>
          <h2>Frequently Asked Questions</h2>
          <p>Quick answers about appointments, insurance, and hospital visits.</p>
        </div>
        <div class="faq-layout">
          <div class="faq-image" data-aos="fade-right">
            <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=800&q=80" alt="Doctor consulting patient" />
          </div>
          <div class="accordion" data-aos="fade-left">
            <div class="accordion-item open">
              <button type="button" class="accordion-header">How do I book an appointment? <i class="fa-solid fa-chevron-down"></i></button>
              <div class="accordion-body"><div class="accordion-content"><p>Use the Book Appointment page or call +1 (800) 555-0147. Choose department, doctor, date, and time — our team will confirm shortly.</p></div></div>
            </div>
            <div class="accordion-item">
              <button type="button" class="accordion-header">Do you accept insurance? <i class="fa-solid fa-chevron-down"></i></button>
              <div class="accordion-body"><div class="accordion-content"><p>Yes. We work with major insurers. Bring your insurance card and ID on your visit for verification.</p></div></div>
            </div>
            <div class="accordion-item">
              <button type="button" class="accordion-header">What should I bring for my first visit? <i class="fa-solid fa-chevron-down"></i></button>
              <div class="accordion-body"><div class="accordion-content"><p>Photo ID, insurance details, current medications list, and any previous medical reports or lab results.</p></div></div>
            </div>
            <div class="accordion-item">
              <button type="button" class="accordion-header">Is emergency care available 24/7? <i class="fa-solid fa-chevron-down"></i></button>
