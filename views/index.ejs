            <div class="dept-card-icon"><i class="<%=department[i].Department_icon%>"></i></div>
            <h3><%=department[i].Department_name%></h3>
            <p><%=department[i].Department_discription%></p>
            <div class="dept-card-meta"><span><i class="fa-solid fa-user-doctor"></i><%=department[i].Doctors%>  Doctors</span><span><i class="fa-solid fa-bed"></i><%=department[i].Beads%>  Beds</span></div>
            <a href="/doctors" class="btn btn-ghost btn-sm">View Doctors</a>
          </article>
          <% } %>
          
        </div>
        <div class="text-center mt-4"><a href="departments.html" class="btn btn-outline">View All Departments <i class="fa-solid fa-arrow-right"></i></a></div>
      </div>


    </section>

