<%-include('header.ejs');%>

  <main id="main-content"></main>
    <!-- Hero -->
    <section class="hero-slider">
      <div class="swiper hero-swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide hero-slide" style="background-image:url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=1920&q=80')">
            <div class="container hero-content">
              <div class="hero-text">
                <span class="hero-eyebrow"><i class="fa-solid fa-shield-heart"></i> Trusted Healthcare Since 1998</span>
                <h1>Medi<span>Care</span> Plus</h1>
                <p class="lead">World-class medical care with compassionate specialists, modern facilities, and round-the-clock emergency support.</p>
                <div class="btn-group">
                  <a href="appointment.html" class="btn btn-secondary btn-lg"><i class="fa-solid fa-calendar-check"></i> Book Appointment</a>
                  <a href="doctors.html" class="btn btn-outline-white btn-lg"><i class="fa-solid fa-user-doctor"></i> Find a Doctor</a>
                </div>
              </div>
              <div class="hero-form-card card-glass">
                <h3><i class="fa-solid fa-calendar-plus"></i> Quick Appointment</h3>
                <p>Book your visit in under a minute</p>
                <form action="#" method="post">
                  <div class="form-group"><input type="text" name="patient_name" class="form-control" placeholder="Your Full Name" required /></div>
                  <div class="form-group"><input type="tel" name="phone" class="form-control" placeholder="Phone Number" required /></div>
                  <div class="form-group">
                    <select name="department" class="form-control" required>
                      <option value="">Select Department</option>
                      <option>Cardiology</option>
                      <option>Neurology</option>
                      <option>Orthopedics</option>
                      <option>Pediatrics</option>
                      <option>Dental</option>
                      <option>Ophthalmology</option>
                      <option>Gynecology</option>
                      <option>Dermatology</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <select name="doctor" class="form-control" required>
                      <option value="">Select Doctor</option>
                      <option>Dr. Sarah Mitchell</option>
                      <option>Dr. James Chen</option>
                      <option>Dr. Priya Sharma</option>
                      <option>Dr. Michael Torres</option>
                    </select>
                  </div>
                  <div class="form-row">
                    <div class="form-group"><input type="date" name="date" class="form-control" required /></div>
                    <div class="form-group">
                      <select name="time" class="form-control" required>
                        <option value="">Time</option>
                        <option>09:00 AM</option>
                        <option>10:00 AM</option>
                        <option>11:00 AM</option>
                        <option>02:00 PM</option>
                        <option>03:00 PM</option>
                        <option>04:00 PM</option>
                      </select>
                    </div>
                  </div>
                  <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-paper-plane"></i> Request Appointment</button>
                </form>
              </div>
            </div>
          </div>
          <div class="swiper-slide hero-slide" style="background-image:url('https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?auto=format&fit=crop&w=1920&q=80')">
            <div class="container hero-content hero-content-center">
              <div class="hero-text text-center">
                <span class="hero-eyebrow"><i class="fa-solid fa-heartbeat"></i> 24/7 Emergency Care</span>
                <h1>Expert Care When<br>Every Second Counts</h1>
                <p class="lead">Our trauma and emergency teams are ready around the clock with advanced life-support systems.</p>
                <div class="btn-group justify-center">
                  <a href="tel:108" class="btn btn-danger btn-lg"><i class="fa-solid fa-phone-volume"></i> Call Emergency</a>
                  <a href="services.html" class="btn btn-outline-white btn-lg">Our Services</a>
                </div>
              </div>
            </div>
          </div>
          <div class="swiper-slide hero-slide" style="background-image:url('https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1920&q=80')">
            <div class="container hero-content hero-content-center">
              <div class="hero-text text-center">
                <span class="hero-eyebrow"><i class="fa-solid fa-stethoscope"></i> Multi-Specialty Excellence</span>
                <h1>Meet Our Specialist Doctors</h1>
                <p class="lead">Board-certified physicians across cardiology, neurology, orthopedics, pediatrics, and more.</p>
                <div class="btn-group justify-center">
                  <a href="doctors.html" class="btn btn-secondary btn-lg">View Doctors</a>
                  <a href="about.html" class="btn btn-outline-white btn-lg">About Hospital</a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </section>

    <!-- Emergency -->
    <section class="emergency-banner">
      <div class="container">
        <div class="emergency-banner-inner">
          <div class="emergency-info">
            <i class="fa-solid fa-truck-medical"></i>
            <div>
              <strong>24/7 Emergency Helpline</strong>
              <span>Immediate ambulance &amp; trauma response</span>
            </div>
          </div>
          <a href="tel:108" class="emergency-number">108 / +1-800-911-HELP</a>
          <a href="appointment.html" class="btn btn-white btn-sm">Book Now</a>
        </div>
      </div>
    </section>

    <!-- Departments -->
    <section class="section" id="departments">
